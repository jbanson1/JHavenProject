# Contact form email delivery (optional for the demo).
# Without RESEND_API_KEY, enquiries are written to the server log instead of emailed.
# Free key: https://resend.com (100 emails/day on the free tier).
RESEND_API_KEY=
# Where enquiries are sent.
CONTACT_TO_EMAIL=
# Sender address. Must be on a domain verified in Resend; until then use onboarding@resend.dev
CONTACT_FROM_EMAIL=Haven website <onboarding@resend.dev>
# Public URL of the site, used for sitemap/Open Graph links.
NEXT_PUBLIC_SITE_URL=https://haven-demo.vercel.app
