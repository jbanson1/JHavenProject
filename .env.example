# Contact form email delivery (optional for the demo).
# The only setting needed for email delivery. Without it, enquiries are written to the server log.
# Free key: https://resend.com (100 emails/day on the free tier).
RESEND_API_KEY=
# Optional overrides. By default enquiries go to site.contact.email (info@inhavenest.com)
# from site.contact.emailFrom, both set in site.config.ts.
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=
# Public URL of the site, used for sitemap/Open Graph links.
NEXT_PUBLIC_SITE_URL=https://www.inhavenest.com
